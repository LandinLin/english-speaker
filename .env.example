# Copy to .env.production on the server and fill in real values.
# .env.production is gitignored and never baked into the image.

# Public site domain for Caddy's automatic HTTPS certificate.
SITE_DOMAIN=buddy.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Neon Postgres (production)
DATABASE_URL=postgresql://neondb_owner:xxxx@xxxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alibaba Cloud ASR
DASHSCOPE_API_KEY=
# DeepSeek LLM
DEEPSEEK_API_KEY=
# Volcengine TTS
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=volcano_tts

# D-ID digital human (client-side public keys; inlined at image build)
NEXT_PUBLIC_DID_CLIENT_KEY=
NEXT_PUBLIC_DID_AGENT_ID=
